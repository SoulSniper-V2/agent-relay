# Copy to .env locally. On Fly/Render, set these as secrets.

RELAY_PORT=8787
RELAY_PUBLIC_URL=https://relay.example.com
RELAY_DB=/data/hub.db

# Email OTP (required for real users). Without this, codes go to RELAY_MAILBOX_DIR.
RELAY_RESEND_KEY=
RELAY_FROM_EMAIL=relay@example.com

# Local-only: write codes to files instead of email
# RELAY_MAILBOX_DIR=/tmp/relay-mail
# RELAY_DEV_OTP=1
