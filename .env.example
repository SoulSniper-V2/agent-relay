# Copy to .env locally. On the GCE VM, these live in /etc/agent-relay.env.

RELAY_PORT=8787
RELAY_PUBLIC_URL=https://35.211.23.64.sslip.io
RELAY_DB=/var/lib/agent-relay/hub.db

# Two-person hosted login needs one of:
# 1) Resend + verified domain (not onboarding@resend.dev)
# RELAY_RESEND_KEY=re_…
# RELAY_FROM_EMAIL=Agent Relay <relay@yourdomain>
# 2) SMTP (Gmail app password). URL-encode @ in the user as %40.
# RELAY_SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# RELAY_FROM_EMAIL=Agent Relay <you@gmail.com>
RELAY_RESEND_KEY=
RELAY_FROM_EMAIL=

# Local-only
# RELAY_MAILBOX_DIR=/tmp/relay-mail
# RELAY_DEV_OTP=1
