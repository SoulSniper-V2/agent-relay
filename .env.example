# Copy to .env locally. On Fly, set these as secrets.

RELAY_PORT=8787
RELAY_PUBLIC_URL=https://agent-relay.fly.dev
RELAY_DB=/data/hub.db

# Both required on the public hub. Before a custom domain is verified:
# RELAY_FROM_EMAIL=Agent Relay <onboarding@resend.dev>
RELAY_RESEND_KEY=
RELAY_FROM_EMAIL=

# Local-only
# RELAY_MAILBOX_DIR=/tmp/relay-mail
# RELAY_DEV_OTP=1
