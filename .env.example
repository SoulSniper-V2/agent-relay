# Copy to .env locally. On Fly, set these as secrets.

RELAY_PORT=8787
RELAY_PUBLIC_URL=https://agent-relay.fly.dev
RELAY_DB=/data/hub.db

# Required for a public hub. Without it, codes write to RELAY_MAILBOX_DIR.
RELAY_RESEND_KEY=
RELAY_FROM_EMAIL=relay@yourdomain.com

# Local-only
# RELAY_MAILBOX_DIR=/tmp/relay-mail
# RELAY_DEV_OTP=1
