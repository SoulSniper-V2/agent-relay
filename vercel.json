{
  "buildCommand": "",
  "outputDirectory": "www",
  "installCommand": "",
  "framework": null,
  "rewrites": [
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/prompt", "destination": "/prompt.txt" },
    { "source": "/skill", "destination": "/skill.md" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(md|txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
